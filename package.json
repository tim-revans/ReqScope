{
  "name": "reqscope",
  "displayName": "ReqScope",
  "publisher": "ReqScope",
  "description": "Requirements viewer from within your code editor.",
  "version": "1.1.0",
  "icon": "images/logo.png",
  "repository": "https://github.com/tim-revans/ReqScope",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reqscope.setJamaCredentials",
        "title": "ReqScope: Set Jama API Credentials"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "ReqScope",
          "title": "ReqScope",
          "icon": "images/logo.png"
        }
      ]
    },
    "views": {
      "ReqScope": [
        {
          "id": "ReqScope",
          "name": "ReqScope",
          "icon": "images/logo.png"
        }
      ]
    },
    "configuration": {
      "title": "ReqScope",
      "type": "object",
      "properties": {
        "ReqScope.provider": {
          "type": "string",
          "description": "Requirements provider",
          "enum": [
            "Jama"
          ],
          "order": 0
        },
        "ReqScope.cacheTimeout": {
          "type": "number",
          "description": "How long (in seconds) before cache entries are marked as stale.",
          "default": 60,
          "order": 1
        },
        "ReqScope.jamaCompanyID": {
          "type": "string",
          "description": "Jama Company ID.",
          "order": 10
        }
      }
    }
  },
  "scripts": {
    "publish": "vsce publish",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
